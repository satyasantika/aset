#!/usr/bin/env bash
set -e
# Laravel 13 butuh PHP >= 8.3. Bila PHP host terlalu lama, jalankan lewat container aset-php
# (mount /home/satya/code/aset -> /var/www/html).
if php -r 'exit(PHP_VERSION_ID >= 80300 && extension_loaded("intl") ? 0 : 1);' 2>/dev/null; then
  run() { "$@"; }
else
  run() {
    docker exec -u "$(id -u)" -e HOME=/tmp -w "/var/www/html" "${SIMAN_PHP_CONTAINER:-aset-php}" "$@"
  }
fi
run ./vendor/bin/pint --test
run php artisan test --parallel --stop-on-failure
