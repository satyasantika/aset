#!/usr/bin/env bash
set -e
# Laravel 13 butuh PHP >= 8.4; bila PHP host lebih lama, jalankan lewat container.
if php -r 'exit(PHP_VERSION_ID >= 80400 ? 0 : 1);' 2>/dev/null; then
  run() { "$@"; }
else
  run() {
    docker run --rm --network host -u "$(id -u):$(id -g)" -e HOME=/tmp -v "$PWD:/var/www/html" -w /var/www/html \
      siman-php:8.4 "$@"
  }
fi
run ./vendor/bin/pint --test
run php artisan test --parallel --stop-on-failure
