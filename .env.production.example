# ASET FKIP — contoh env produksi. SALIN ke .env.production dan isi nilai rahasia di server; JANGAN commit hasilnya.
APP_NAME="ASET FKIP"
APP_ENV=production
APP_DEBUG=false
APP_KEY=                      # php artisan key:generate --show
# Dipasang di subpath: seluruh URL aplikasi dibangun dari nilai ini (termasuk /aset).
APP_URL=https://supportfkip.unsil.ac.id/aset
APP_VERSION=1.0.0
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Basis data: SQLite pada volume `data` (tanpa MySQL). Mode WAL + busy timeout untuk beberapa proses.
DB_CONNECTION=sqlite
DB_DATABASE=/data/database.sqlite
DB_BUSY_TIMEOUT=5000
DB_JOURNAL_MODE=WAL
DB_SYNCHRONOUS=NORMAL

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
CACHE_PREFIX=siman_
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_COOKIE=siman_session
SESSION_PATH=/aset
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log

# Surel (isi dengan SMTP kampus)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=null
MAIL_FROM_ADDRESS=aset@fkip.unsil.ac.id
MAIL_FROM_NAME="${APP_NAME}"

# WhatsApp opsional (pengingat)
WHATSAPP_ENABLED=false
WHATSAPP_URL=
WHATSAPP_TOKEN=

# Compose
WEB_PORT=8080
CADANGAN_HARI=30
CADANGAN_JAM=02:00
