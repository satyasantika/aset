# ASET FKIP — contoh env produksi. SALIN ke .env.production dan isi nilai rahasia di server; JANGAN commit hasilnya.
APP_NAME="ASET FKIP"
# nama pendek aplikasi: awalan kunci cache bersama (detak penjadwal)
APP_KODE=aset
APP_ENV=production
APP_DEBUG=false
APP_KEY=                      # php artisan key:generate --show
# Dipasang di subpath: seluruh URL aplikasi dibangun dari nilai ini (termasuk /aset).
APP_URL=https://supportfkip.unsil.ac.id/aset
APP_VERSION=1.0.0
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_LEVEL=warning

# MariaDB native di host (dijangkau container lewat host.docker.internal). Buat DB dan pengguna khusus aplikasi.
DB_CONNECTION=mariadb
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=db_aset
DB_USERNAME=aset
DB_PASSWORD=

# Profil Ringan (STANDAR-TEKNIS §1b): sesi, cache, antrean, dan lock di database; tanpa Redis.
CACHE_PREFIX=aset_cache_
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_COOKIE=aset_session
SESSION_PATH=/aset
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# Surel (isi dengan SMTP kampus)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=null
MAIL_FROM_ADDRESS=aset@fkip.unsil.ac.id
MAIL_FROM_NAME="${APP_NAME}"

# WhatsApp opsional (pengingat)
WHATSAPP_ENABLED=false
WHATSAPP_URL=
WHATSAPP_TOKEN=

# Compose
WEB_PORT=8080
CADANGAN_HARI=30
CADANGAN_JAM=02:00
